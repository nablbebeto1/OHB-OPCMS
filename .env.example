# ==============================================================================
# OHB Polio Campaign Management System (OPCMS) - Environment Configuration
# ==============================================================================
# Copy this file to .env on the target host and replace CHANGE_ME_* values.
# Never commit real .env credentials to version control.

# Application & Runtime
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
PUBLIC_DOMAIN="polio.orhb.gov.et"

# Production Server Target (odmcserver / Ubuntu 24 LTS)
OPCMS_APP_DIR="/opt/ohb-polio-command"
OPCMS_FRONTEND_HOST="127.0.0.1"
OPCMS_FRONTEND_PORT=3100
OPCMS_BACKEND_HOST="127.0.0.1"
OPCMS_BACKEND_PORT=8100

# Frontend API Base URL (relative /api/v1 works behind Nginx/Apache & Vite proxy)
VITE_API_BASE_URL="/api/v1"

# Python FastAPI Backend Configuration
FASTAPI_HOST="127.0.0.1"
FASTAPI_PORT=8100
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://polio.orhb.gov.et"

# PostgreSQL Database (bind localhost-only in production)
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_DB="opcms_db"
POSTGRES_USER="opcms_user"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
DATABASE_URL="postgresql+psycopg2://opcms_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/opcms_db"

# Authentication, Security & Rate Limiting
JWT_SECRET_KEY="CHANGE_ME_GENERATE_64_CHAR_HEX_SECRET"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
RATE_LIMIT_LOGIN_PER_MIN=30
RATE_LIMIT_API_PER_MIN=600

# Command Room Large-Screen Defaults
COMMAND_ROOM_DEFAULT_ROTATION_SEC=30
COMMAND_ROOM_TIMEZONE="Africa/Addis_Ababa"
